DATABASE_URL=postgres://user:password@host:5432/dbname

# Auth.js (v5). Generate AUTH_SECRET locally: `npx auth secret` (or `openssl rand -base64 32`).
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# On Vercel: AUTH_URL is set automatically to your deployment URL.
# Locally, Auth.js defaults to http://localhost:3000 — set this if you use a different port.
# AUTH_URL=http://localhost:3005
