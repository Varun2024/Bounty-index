{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "bounty-index",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    // Node.js API surface — mandatory for the OpenNext adapter.
    "nodejs_compat",
    // Let the app fetch its own public URLs.
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bounty-index"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "bounty-index-inc-cache"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "bounty-index-tag-cache",
      "database_id": "0fb8f7b9-792a-4843-9073-4f2cfc24b1f2"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ]
}
